{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build USB firmware (Arm GCC)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "RemoteSigned",
        "-File",
        "${workspaceFolder}/.vscode/build-gcc.ps1"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Upload firmware via ST-LINK (OpenOCD)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "RemoteSigned",
        "-File",
        "${workspaceFolder}/.vscode/flash.ps1",
        "UploadSwd"
      ],
      "problemMatcher": []
    },
    {
      "label": "Install USB bootloader once (ST-LINK)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "RemoteSigned",
        "-File",
        "${workspaceFolder}/.vscode/flash.ps1",
        "Install"
      ],
      "problemMatcher": []
    },
    {
      "label": "Upload firmware via Micro-USB (DFU)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "RemoteSigned",
        "-File",
        "${workspaceFolder}/.vscode/flash.ps1",
        "Upload"
      ],
      "problemMatcher": []
    }
  ]
}
